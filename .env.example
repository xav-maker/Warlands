# Copier vers .env pour le développement local.
DATABASE_URL=postgres://cr:cr@localhost:5433/cr
APP_URL=http://localhost:3000
PORT=3000
SESSION_COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Les Cinq Régions <noreply@localhost>
LOG_LEVEL=info
# Chat, messages, amis et boutiques réservés aux adresses e-mail vérifiées (vrai par défaut).
# En local, le lien arrive dans Mailpit ; sinon `pnpm verify-email <e-mail>`.
# REQUIRE_VERIFIED_EMAIL=false
# Modération réservée aux comptes avec double authentification (vrai par défaut). Activation depuis la page Compte ;
# `pnpm reset-2fa <e-mail>` la retire à un compte qui a perdu son téléphone.
# REQUIRE_STAFF_2FA=false
