<% layout('./layout', { title: it.R.city.name, v: it.v, error: it.error }) %>
<%~ include('./partials/verify-banner', { auth: it.auth }) %>
<section class="city">
  <p class="eyebrow"><%= it.R.name %> · palier <%= it.R.tier %></p>
  <h1><%= it.R.city.name %></h1>
  <p class="muted"><%= it.R.city.desc %> Vos troupes sont soignées dès leur entrée en ville.</p>
  <% if (!it.tut.hidden && !it.tut.finished) { %><%~ include('./partials/tutorial', { tut: it.tut, csrf: it.csrf, full: true }) %><% } %>

  <div class="grid">
    <div class="card">
      <h2>Partir</h2>
      <% for (const d of it.v.departures) { const T = it.L.route(d.route) %>
        <form method="post" action="/depart" class="row between departure">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="direction" value="<%= d.direction %>">
          <input type="hidden" name="route" value="<%= d.route %>">
          <span><b><%= T.name %></b><br><span class="muted"><%= d.to ? 'vers ' + it.L.region(d.to).city.name : 'cul-de-sac' %><%= d.direction < 0 ? ' (à rebours)' : '' %></span></span>
          <button type="submit" class="primary">Partir<%= it.toll ? ' (' + it.toll + ' or)' : '' %></button>
        </form>
      <% } %>
      <% if (it.toll) { %><p class="muted">Chaque départ coûte <%= it.toll %> or, comme chaque retour à l’étape précédente sur la route.</p><% } %>
    </div>

    <div class="card">
      <h2>Escouade</h2>
      <%~ include('./partials/squad', { v: it.v, L: it.L, csrf: it.csrf, back: '/ville', consumables: false }) %>
      <% const barracks = it.v.troops.filter((t) => t.container === 'BARRACKS' && t.units.length) %>
      <% if (barracks.length) { %><p class="muted">En caserne : <%= barracks.map((t) => t.name + ' (niv. ' + t.level + ')').join(', ') %>.</p><% } %>
    </div>

    <div class="card">
      <h2>Services</h2>
      <ul class="tiles">
        <li><a href="/caserne"><svg class="ico" aria-hidden="true"><use href="#i-sword"></use></svg><b>Caserne</b><span>recruter, engager, racheter des unités</span></a></li>
        <li><a href="/atelier"><svg class="ico" aria-hidden="true"><use href="#i-hammer"></use></svg><b>Atelier</b><span>fabriquer équipement et consommables</span></a></li>
        <li><a href="/marchand"><svg class="ico" aria-hidden="true"><use href="#i-coins"></use></svg><b>Marchand</b><span>équipement et consommables du palier <%= it.R.tier %></span></a></li>
        <li><a href="/boutique"><svg class="ico" aria-hidden="true"><use href="#i-shop"></use></svg><b>Boutique</b><span>acheter et vendre entre joueurs</span></a></li>
        <li><a href="/quetes"><svg class="ico" aria-hidden="true"><use href="#i-scroll"></use></svg><b>Quêtes</b><span>trophées des rares et des boss</span></a></li>
        <li><a href="/sac"><svg class="ico" aria-hidden="true"><use href="#i-bag"></use></svg><b>Sac et banque</b><span>sac <%= it.v.bag.used %> / <%= it.v.bag.cap %> · banque <%= it.v.bank.used %> / <%= it.v.bank.cap %></span></a></li>
        <li><a href="/codex"><svg class="ico" aria-hidden="true"><use href="#i-book"></use></svg><b>Codex</b><span>troupes, monstres, objets, régions</span></a></li>
        <li><a href="/tutoriel"><svg class="ico" aria-hidden="true"><use href="#i-help"></use></svg><b>Guide</b><span>les premiers pas</span></a></li>
      </ul>
      <%~ include('./partials/dispo', { dungeonAvailable: it.v.dungeonAvailable, csrf: it.csrf }) %>
      <p class="muted">Disponible, vous pouvez être invité au hasard dans le donjon d’un joueur de la région.</p>
      <p class="muted"><%= it.v.stats.fights %> combats, <%= it.v.stats.wins %> victoires, <%= it.v.stats.deaths %> unités perdues.</p>
    </div>
  </div>
</section>
