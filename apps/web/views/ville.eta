<% layout('./layout', { title: it.R.city.name, v: it.v, error: it.error }) %>
<%~ include('./partials/verify-banner', { auth: it.auth }) %>
<section class="city">
  <p class="eyebrow"><%= it.R.name %> · palier <%= it.R.tier %></p>
  <h1><%= it.R.city.name %></h1>
  <p class="muted"><%= it.R.city.desc %> Vos troupes sont soignées dès leur entrée en ville.</p>

  <div class="grid">
    <div class="card">
      <h2>Partir</h2>
      <% for (const d of it.v.departures) { const T = it.L.route(d.route) %>
        <form method="post" action="/depart" class="row between departure">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="direction" value="<%= d.direction %>">
          <input type="hidden" name="route" value="<%= d.route %>">
          <span><b><%= T.name %></b><br><span class="muted"><%= d.to ? 'vers ' + it.L.region(d.to).city.name : 'cul-de-sac' %><%= d.direction < 0 ? ' (à rebours)' : '' %></span></span>
          <button type="submit" class="primary">Partir</button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h2>Escouade</h2>
      <%~ include('./partials/squad', { v: it.v, L: it.L, csrf: it.csrf, back: '/ville', consumables: false }) %>
      <% const barracks = it.v.troops.filter((t) => t.container === 'BARRACKS' && t.units.length) %>
      <% if (barracks.length) { %><p class="muted">En caserne : <%= barracks.map((t) => t.name + ' (niv. ' + t.level + ')').join(', ') %>.</p><% } %>
    </div>

    <div class="card">
      <h2>Services</h2>
      <ul class="tiles">
        <li><a href="/caserne"><b>Caserne</b><span>recruter, engager, racheter des unités</span></a></li>
        <li><a href="/atelier"><b>Atelier</b><span>fabriquer l’équipement et les consommables de vos recettes</span></a></li>
        <li><a href="/quetes"><b>Quêtes</b><span>rapporter les trophées des monstres rares et des boss</span></a></li>
        <li><a href="/boutique"><b>Boutique</b><span>acheter et vendre entre joueurs, à <%= it.R.city.name %></span></a></li>
        <li><a href="/marchand"><b>Marchand</b><span>équipement et consommables du palier <%= it.R.tier %></span></a></li>
        <li><a href="/sac"><b>Sac et banque</b><span>sac <%= it.v.bag.used %> / <%= it.v.bag.cap %>, banque <%= it.v.bank.used %> / <%= it.v.bank.cap %></span></a></li>
        <li><a href="/codex"><b>Codex</b><span>troupes, monstres, objets, régions</span></a></li>
      </ul>
      <%~ include('./partials/dispo', { dungeonAvailable: it.v.dungeonAvailable, csrf: it.csrf }) %>
      <p class="muted">Disponible, vous pouvez être invité au hasard dans le donjon d’un joueur de la région.</p>
      <p class="muted"><%= it.v.stats.fights %> combats, <%= it.v.stats.wins %> victoires, <%= it.v.stats.deaths %> unités perdues.</p>
    </div>
  </div>
</section>
