<% layout('./layout', { title: it.R.city.name, v: it.v, error: it.error }) %>
<% if (!it.auth.account.email_verified_at) { %>
  <div class="flash">
    Votre adresse e-mail n’est pas encore vérifiée : elle le sera avant d’accéder aux boutiques et au chat.
    <button class="link" hx-post="/verifier/renvoyer" hx-target="#flash">Renvoyer l’e-mail</button>
  </div>
<% } %>
<section class="city">
  <p class="eyebrow"><%= it.R.name %> · palier <%= it.R.tier %></p>
  <h1><%= it.R.city.name %></h1>
  <p class="muted"><%= it.R.city.desc %> Vos troupes sont soignées dès leur entrée en ville.</p>

  <div class="grid">
    <div class="card">
      <h2>Partir</h2>
      <% for (const d of it.v.departures) { const T = it.L.region(d.route) %>
        <form method="post" action="/depart" class="row between">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="direction" value="<%= d.direction %>">
          <span><b><%= T.territory.name %></b><br><span class="muted"><%= d.to ? 'vers ' + it.L.region(d.to).city.name : 'cul-de-sac' %><%= d.direction < 0 ? ' (à rebours)' : '' %></span></span>
          <button type="submit" class="primary">Partir</button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h2>Escouade</h2>
      <%~ include('./partials/squad', { v: it.v, L: it.L, csrf: it.csrf, back: '/ville', consumables: false }) %>
      <% const barracks = it.v.troops.filter((t) => t.container === 'BARRACKS' && t.units.length) %>
      <% if (barracks.length) { %><p class="muted">En caserne : <%= barracks.map((t) => t.name + ' (niv. ' + t.level + ')').join(', ') %>.</p><% } %>
    </div>

    <div class="card">
      <h2>Services</h2>
      <ul class="links">
        <li><a href="/caserne">Caserne</a> <span class="muted">— recruter, engager, racheter des unités</span></li>
        <li><a href="/atelier">Atelier</a> <span class="muted">— fabriquer l’équipement et les consommables de vos recettes</span></li>
        <li><a href="/quetes">Quêtes</a> <span class="muted">— rapporter les trophées des monstres rares</span></li>
        <li><a href="/marchand">Marchand</a> <span class="muted">— équipement et consommables du palier <%= it.R.tier %></span></li>
        <li><a href="/sac">Sac et banque</a> <span class="muted">— sac <%= it.v.bag.used %> / <%= it.v.bag.cap %>, banque <%= it.v.bank.used %> / <%= it.v.bank.cap %></span></li>
        <li><a href="/codex">Codex</a></li>
      </ul>
      <p class="muted"><%= it.v.stats.fights %> combats, <%= it.v.stats.wins %> victoires, <%= it.v.stats.deaths %> unités perdues.</p>
    </div>
  </div>
</section>
