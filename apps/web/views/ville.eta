<% layout('./layout', { title: 'Havre-Gris' }) %>
<% if (!it.auth.account.email_verified_at) { %>
  <div class="flash">
    Votre adresse e-mail n’est pas encore vérifiée : elle le sera avant d’accéder aux boutiques et au chat.
    <button class="link" hx-post="/verifier/renvoyer" hx-target="#flash">Renvoyer l’e-mail</button>
  </div>
<% } %>
<section class="city">
  <p class="eyebrow">Pays de Havre-Gris</p>
  <h1>Havre-Gris</h1>
  <p class="muted">Bienvenue, <%= it.auth.player.pseudo %>. La ville ouvrira ses portes au jalon J2 : caserne, atelier, marchand, banque, quêtes et départ vers la Forêt des Ronces.</p>
  <div class="card">
    <h2>Donjons</h2>
    <%~ include('./partials/dispo', { dungeonAvailable: it.dungeonAvailable, csrf: it.csrf }) %>
  </div>
</section>
