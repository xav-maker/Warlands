<% layout('./layout', { title: 'Discussion', v: it.v, error: it.error, script: '/static/social.js' }) %>
<% const general = it.channel === 'general' %>
<%~ include('./partials/verify-banner', { auth: it.auth }) %>
<%~ include('./partials/social-tabs', { tab: 'chat' }) %>
<section>
  <p class="eyebrow">Discussion</p>
  <h1><%= general ? 'Canal général' : it.regionName %></h1>
  <nav class="tabs" aria-label="Canal">
    <a href="/chat"<%~ general ? '' : ' aria-current="page"' %>>Région : <%= it.regionName %></a>
    <a href="/chat?canal=general"<%~ general ? ' aria-current="page"' : '' %>>Général</a>
  </nav>
  <p class="muted"><%= it.online %> joueur<%= it.online > 1 ? 's' : '' %> en ligne <%= general ? 'dans tout le jeu' : 'dans la région' %>. <%= general ? 'Le canal général est lu par tous les joueurs, où qu’ils soient.' : 'Le canal de la région est lu par les joueurs de la région.' %> 300 caractères au plus, un message par seconde ; les messages sont gardés 7 jours. Un joueur gênant se bloque (ses messages disparaissent pour vous) ou se signale à la modération.</p>
  <ul id="chat-log" class="chat card" data-src="/chat/messages<%= general ? '?canal=general' : '' %>" data-channel="<%= it.channel %>" aria-live="polite" aria-label="<%= general ? 'Fil du canal général' : 'Fil de la région' %>"><%~ include('./partials/chat-log', { log: it.log, csrf: it.csrf, auth: it.auth }) %></ul>
  <form id="chat-form" method="post" action="/chat" hx-post="/chat" hx-swap="none" class="row chat-form">
    <input type="hidden" name="canal" value="<%= general ? 'general' : 'region' %>">
    <label class="grow">Message<%= general ? ' (canal général)' : '' %>
      <input type="text" name="text" maxlength="300" required autocomplete="off" autofocus>
    </label>
    <%~ include('./partials/link-select', { cite: it.cite }) %>
    <button type="submit" class="primary">Envoyer</button>
  </form>
</section>
