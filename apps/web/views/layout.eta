<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}'>
  <title><%= it.title ? it.title + ' · ' : '' %>Les Cinq Régions</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body hx-headers='<%= JSON.stringify({ "x-csrf-token": it.csrf }) %>'>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/">Les Cinq Régions</a>
      <nav>
        <% if (it.auth) { %>
          <span class="who"><%= it.auth.player.pseudo %></span>
          <form method="post" action="/deconnexion" class="inline">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>">
            <button type="submit" class="link">Se déconnecter</button>
          </form>
        <% } else { %>
          <a href="/connexion">Connexion</a>
          <a href="/inscription" class="btn">Créer un compte</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <div id="flash" aria-live="polite"></div>
    <%~ it.body %>
  </main>
</body>
</html>
