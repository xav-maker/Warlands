<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}'>
  <title><%= it.title ? it.title + ' · ' : '' %>Les Cinq Régions</title>
  <link rel="stylesheet" href="/static/app.css">
  <% if (it.refresh) { %><noscript><meta http-equiv="refresh" content="<%= it.refresh %>"></noscript><% } %>
  <% if (it.css) { %><link rel="stylesheet" href="<%= it.css %>"><% } %>
  <% if (it.script) { %><script src="<%= it.script %>" defer></script><% } %>
  <script src="/static/htmx.min.js" defer></script>
  <% if (it.auth) { %><script src="/static/events.js" defer></script><% } %>
</head>
<body hx-headers='<%= JSON.stringify({ "x-csrf-token": it.csrf }) %>'>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/">Les Cinq Régions</a>
      <nav>
        <% if (it.auth) { %>
          <a href="/jeu">Jouer</a>
          <a href="/sac">Sac</a>
          <a href="/codex">Codex</a>
          <a href="/chat">Discussion</a>
          <% if (it.auth.account.role !== 'player') { %><a href="/moderation">Modération</a><% } %>
          <a href="/compte">Compte</a>
          <% if (it.v && it.v.unread) { %><a href="/notifications" class="badge" title="Notifications non lues">✉ <%= it.v.unread %></a><% } %>
          <% if (it.v) { %><span class="gold" title="Or"><%= it.v.gold %> or</span><% } %>
          <span class="who"><%= it.auth.player.pseudo %></span>
          <form method="post" action="/deconnexion" class="inline">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>">
            <button type="submit" class="link">Se déconnecter</button>
          </form>
        <% } else { %>
          <a href="/connexion">Connexion</a>
          <a href="/inscription" class="btn">Créer un compte</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <div id="flash" aria-live="polite"><% if (it.error) { %><p class="flash bad" role="alert"><%= it.error %></p><% } %></div>
    <%~ it.body %>
  </main>
  <div id="toasts" aria-live="polite" aria-atomic="false"></div>
</body>
</html>
