<% layout('./layout', { title: 'Caserne' }) %>
<% const rv = it.rv; const c = it.c %>
<section>
  <p class="eyebrow"><%= it.R.city.name %></p>
  <h1>Caserne</h1>
  <p class="muted">Vos recettes sont personnelles : les ingrédients sont pris d’abord en banque, puis dans le sac. Une recrue rejoint l’escouade si elle y tient (8 unités, 11 de population), sinon elle attend ici.</p>
  <div class="grid">
    <div class="card">
      <h2>Recruter</h2>
      <ul class="items">
        <% for (const type of it.R.city.recruit) { const d = c.troops[type]; const r = rv.recipes.get(type); if (!r) continue; const ok = it.v.gold >= r.gold && r.ingredients.every(([i, q]) => (rv.owned.get(i) ?? 0) >= q) %>
          <li>
            <div class="row between">
              <span><b><%= d.name %></b> <span class="muted">— <%= d.role %> · <%= d.units %> unité<%= d.units > 1 ? 's' : '' %>, <%= d.pop %> de pop. · niv. <%= it.R.minLevel %></span></span>
              <form method="post" action="/caserne/recruter" class="inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <input type="hidden" name="type" value="<%= type %>">
                <button type="submit"<%= ok ? '' : ' disabled' %>>Recruter</button>
              </form>
            </div>
            <p class="muted"><%= r.gold %> or · <%= r.ingredients.map(([i, q]) => it.L.item(i) + ' ' + (rv.owned.get(i) ?? 0) + '/' + q).join(', ') %></p>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="card">
      <h2>Vos troupes</h2>
      <ul class="items">
        <% for (const t of it.v.troops.filter((x) => x.units.length)) { const d = c.troops[t.type]; const missing = d.units - t.units.length; const here = it.R.city.recruit.includes(t.type) %>
          <li>
            <div class="row between">
              <span><a href="/troupe/<%= t.id %>"><b><%= t.name %></b></a> <span class="muted">niv. <%= t.level %> · <%= t.units.length %>/<%= d.units %> unité<%= d.units > 1 ? 's' : '' %> · <%= t.container === 'SQUAD' ? 'en escouade' : 'en caserne' %><%= t.loaned ? ' · prêtée par la garde' : '' %></span></span>
              <form method="post" action="/troupe/<%= t.id %>/<%= t.container === 'SQUAD' ? 'retirer' : 'engager' %>" class="inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <input type="hidden" name="back" value="/caserne">
                <button type="submit"><%= t.container === 'SQUAD' ? 'Retirer' : 'Engager' %></button>
              </form>
            </div>
            <% if (missing > 0) { const r = rv.recipes.get(t.type); const cost = r ? it.scaled(r, missing / d.units) : null %>
              <div class="row between">
                <span class="muted"><%= missing %> unité<%= missing > 1 ? 's' : '' %> manquante<%= missing > 1 ? 's' : '' %><%= cost ? ' · rachat : ' + cost.gold + ' or, ' + cost.ingredients.map(([i, q]) => it.L.item(i) + ' ' + (rv.owned.get(i) ?? 0) + '/' + q).join(', ') : '' %><%= here ? '' : ' · se rachète dans sa ville de recrutement' %></span>
                <% if (here) { %>
                  <form method="post" action="/troupe/<%= t.id %>/racheter" class="inline">
                    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                    <input type="hidden" name="back" value="/caserne">
                    <button type="submit">Racheter</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
  <p><a href="/ville">Retour à la ville</a></p>
</section>
