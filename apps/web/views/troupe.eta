<% layout('./layout', { title: it.t.name }) %>
<% const t = it.t; const next = it.xpToNext(t.level) %>
<section>
  <p class="eyebrow"><%= it.def.name %> · <%= t.container === 'SQUAD' ? 'en escouade' : 'en caserne' %></p>
  <h1><%= t.name %></h1>
  <p class="muted">Niveau <%= t.level %><%= t.level < 30 ? ' · ' + t.xp + ' / ' + next + ' XP' : ' (maximum)' %> · <%= it.def.role %></p>
  <div class="grid">
    <div class="card">
      <h2>Unités</h2>
      <ul class="group">
        <% for (const u of t.units) { %>
          <li class="unit">
            <span class="muted"><%= t.units.length > 1 ? 'unité ' + u.n : '' %></span>
            <span class="gauge hp"><i style="width:<%= Math.round(100 * u.hp / u.hpMax) %>%"></i></span><span class="num"><%= u.hp %> / <%= u.hpMax %> PV</span>
            <% if (u.manaMax) { %><span class="gauge mana"><i style="width:<%= Math.round(100 * u.mana / u.manaMax) %>%"></i></span><span class="num"><%= u.mana %> / <%= u.manaMax %></span><% } %>
          </li>
        <% } %>
      </ul>
      <form method="post" action="/troupe/<%= t.id %>/rang" class="row">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <label>Rang de départ
          <select name="rank">
            <% for (const r of [1, 2, 3]) { %><option value="<%= r %>"<%= r === t.rank ? ' selected' : '' %>><%= r %><%= r === 1 ? ' (contact)' : r === 3 ? ' (arrière)' : '' %></option><% } %>
          </select>
        </label>
        <button type="submit">Changer</button>
      </form>
    </div>

    <% if (it.evolutions.length) { %>
      <div class="card">
        <h2>Évolutions</h2>
        <p class="muted">Facultatives et définitives. La troupe garde son niveau, son XP et ses unités, et apprend les capacités de sa nouvelle forme.<%= it.canEvolveHere ? '' : ' Elle évolue dans une ville qui la recrute.' %></p>
        <ul class="items">
          <% for (const e of it.evolutions) { const f = e.form; const r = e.recipe; const ok = t.level >= f.level && it.v.gold >= r.gold && r.ingredients.every(([i, q]) => (e.owned[i] ?? 0) >= q) %>
            <li>
              <div class="row between">
                <span><b><%= f.name %></b> <span class="muted">— niveau <%= f.level %> requis · PV ×<%= (f.hpMult ?? 1000) / 1000 %> · vitesse <%= f.speed %></span></span>
                <% if (it.canEvolveHere) { %>
                  <form method="post" action="/troupe/<%= t.id %>/evoluer" class="inline">
                    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                    <input type="hidden" name="form" value="<%= f.id %>">
                    <button type="submit"<%= ok ? '' : ' disabled' %>>Évoluer</button>
                  </form>
                <% } %>
              </div>
              <div class="spells"><% for (const [s, l] of f.skills) { %><%~ include('./partials/spell', { id: s, L: it.L, level: l }) %><% } %></div>
              <p class="muted"><%= r.gold %> or · <%= r.ingredients.map(([i, q]) => it.L.item(i) + ' ' + (e.owned[i] ?? 0) + '/' + q).join(', ') %></p>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>

    <div class="card">
      <h2>Équipement</h2>
      <p class="muted"><%= it.v.kind === 'city' ? 'En ville : depuis la banque ou le sac ; un changement soigne l’unité.' : 'En expédition : depuis le sac seulement ; un objet retiré va dans le sac.' %></p>
      <% for (const u of t.units) { %>
        <% if (t.units.length > 1) { %><h3>Unité <%= u.n %></h3><% } %>
        <ul class="items">
          <% for (const [slot, cats] of Object.entries(it.slots)) { const cur = u.equip[slot]; const options = it.wearable(slot) %>
            <li>
              <div class="row between">
                <span><b><%= slot %></b> <span class="muted">(<%= cats.join(', ') %>)</span> : <%= cur ? it.L.item(cur.base) + ' — ' + it.L.quality(cur.roll) + ' : ' + cur.stats.map(it.L.statText).join(', ') : 'rien' %></span>
                <% if (cur) { %>
                  <form method="post" action="/troupe/<%= t.id %>/desequiper" class="inline">
                    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                    <input type="hidden" name="unit" value="<%= u.n %>">
                    <input type="hidden" name="slot" value="<%= slot %>">
                    <button type="submit">Retirer</button>
                  </form>
                <% } %>
              </div>
              <% if (options.length) { %>
                <form method="post" action="/troupe/<%= t.id %>/equiper" class="row">
                  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                  <input type="hidden" name="unit" value="<%= u.n %>">
                  <select name="instance" aria-label="Objet à porter (<%= slot %>)">
                    <% for (const o of options) { %><option value="<%= o.id %>"><%= it.L.item(o.base) %> — <%= it.L.quality(o.roll) %> (<%= o.from %>) : <%= o.stats.map(it.L.statText).join(', ') %></option><% } %>
                  </select>
                  <button type="submit">Équiper</button>
                </form>
              <% } %>
            </li>
          <% } %>
          <% if (!Object.keys(it.slots).length) { %><li class="muted">Ce type ne porte pas d’équipement.</li><% } %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2>Capacités</h2>
      <p class="muted">Cochez une capacité pour que la troupe ne s’en serve plus. Au combat, elle utilise l’attaque de base et ses 5 capacités les plus récentes parmi celles qui restent.</p>
      <form method="post" action="/troupe/<%= t.id %>/capacites">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <ul class="items">
          <% for (const s of it.known) { const off = t.disabledSkills.includes(s) %>
            <li class="row between">
              <label class="check">
                <input type="checkbox" name="off_<%= s %>"<%= off ? ' checked' : '' %><%= s === it.base ? ' disabled' : '' %>>
                Désactiver <%~ include('./partials/spell', { id: s, L: it.L }) %><%= s === it.base ? ' (attaque de base)' : '' %>
              </label>
              <span class="<%= it.active.includes(s) ? 'good' : 'muted' %>"><%= it.active.includes(s) ? 'active' : off ? 'désactivée' : 'en réserve' %></span>
            </li>
          <% } %>
        </ul>
        <button type="submit">Enregistrer</button>
      </form>
    </div>
  </div>
  <p><a href="<%= it.v.kind === 'city' ? '/caserne' : '/route' %>">Retour</a></p>
</section>
