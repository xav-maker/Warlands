<% if (it.auth && !it.auth.account.email_verified_at) { %>
  <div class="flash">
    Votre adresse e-mail n’est pas encore vérifiée : ouvrez le lien reçu par courriel pour utiliser le chat, les messages, les amis et les boutiques.
    <button class="link" hx-post="/verifier/renvoyer" hx-target="#flash">Renvoyer l’e-mail</button>
  </div>
<% } %>
