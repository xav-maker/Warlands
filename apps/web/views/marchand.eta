<% layout('./layout', { title: 'Marchand', v: it.v, error: it.error }) %>
<% const offers = it.R.city.shop.map((id) => ({ id, price: it.L.buyPrice(id), ok: it.v.gold >= it.L.buyPrice(id) })) %>
<section>
  <p class="eyebrow"><%= it.R.city.name %></p>
  <h1>Marchand</h1>
  <p class="muted">Ce que vous achetez arrive en banque. L’équipement du marchand est de qualité « médiocre ». Il rachète tout à 20 % de la valeur.</p>
  <div class="grid">
    <div class="card">
      <h2>À vendre <span class="count"><%= offers.filter((x) => x.ok).length %> à votre portée</span></h2>
      <ul class="offers">
        <% for (const { id, price, ok } of offers) { %>
          <li class="offer <%= ok ? 'ok' : 'ko' %>">
            <div class="row">
              <span class="title"><%= it.L.item(id) %></span>
              <span class="actions">
                <span class="price coin <%= ok ? 'ok' : 'ko' %>"><%= price %> or</span>
                <form method="post" action="/marchand/acheter" class="inline">
                  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                  <input type="hidden" name="id" value="<%= id %>">
                  <button type="submit" class="buy"<%= ok ? '' : ' disabled' %>>Acheter</button>
                </form>
              </span>
            </div>
          </li>
        <% } %>
      </ul>
    </div>
    <div class="card">
      <h2>Vendre depuis le sac</h2>
      <%~ include('./partials/items', { x: it.v.bag, from: 'BAG', L: it.L, csrf: it.csrf, back: '/marchand', actions: ['vendre'] }) %>
    </div>
    <div class="card">
      <h2>Vendre depuis la banque</h2>
      <%~ include('./partials/items', { x: it.v.bank, from: 'BANK', L: it.L, csrf: it.csrf, back: '/marchand', actions: ['vendre'] }) %>
    </div>
  </div>
  <p><a href="/ville">Retour à la ville</a></p>
</section>
