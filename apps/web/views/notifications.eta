<% layout('./layout', { title: 'Notifications' }) %>
<% const SANC = { mute: 'Sourdine', shop_ban: 'Interdiction de boutique', suspend: 'Suspension', ban: 'Bannissement' } %>
<% const until = (d) => d ? 'jusqu’au ' + new Date(d).toLocaleString('fr-FR', { timeZone: 'Europe/Paris', dateStyle: 'short', timeStyle: 'short' }) : 'sans date de fin' %>
<% const text = (n) => n.type === 'shop.sold' ? 'Vente à ' + it.L.region(n.data.ville).city.name + ' : ' + n.data.name + (n.data.qty > 1 ? ' × ' + n.data.qty : '') + ' pour ' + n.data.price + ' or (taxe ' + n.data.tax + ' or).' : n.type === 'shop.expired' ? 'Annonce expirée à ' + it.L.region(n.data.ville).city.name + ' : ' + n.data.name + (n.data.qty > 1 ? ' × ' + n.data.qty : '') + ', revenu dans votre banque.' : n.type === 'dm.received' ? 'Nouveau message privé de ' + n.data.from + '.' : n.type === 'friend.request' ? n.data.from + ' vous demande en ami.' : n.type === 'friend.accepted' ? n.data.from + ' a accepté votre demande d’ami.' : n.type === 'report.closed' ? 'Votre signalement #' + n.data.report + ' est traité : ' + n.data.decision : n.type === 'sanction.applied' ? SANC[n.data.kind] + ' ' + until(n.data.until) + ' : ' + n.data.reason : n.type === 'dungeon.invite' ? n.data.from + ' vous a invité dans un donjon.' : n.type === 'dungeon.declined' ? n.data.from + ' a décliné votre invitation de donjon.' : n.type === 'dungeon.invite_expired' ? 'Personne n’a accepté votre invitation de donjon à temps.' : n.type === 'dungeon.partner_left' ? n.data.from + (n.data.idle ? ' était absent : il est sorti du donjon.' : ' a quitté le donjon.') : n.type === 'pseudo.renamed' ? 'Votre pseudo « ' + n.data.from + ' » a été remplacé par « ' + n.data.to + ' » : ' + n.data.reason + '. Choisissez-en un nouveau depuis la page Compte.' : n.type %>
<% const href = (n) => n.type === 'dm.received' ? '/messages/' + encodeURIComponent(n.data.from) : n.type.startsWith('friend.') ? '/amis' : n.type === 'dungeon.invite' && n.data.run ? '/donjon/invitation/' + Number(n.data.run) : n.type.startsWith('dungeon.') ? '/donjon' : null %>
<section>
  <h1>Notifications</h1>
  <% if (it.list.some((n) => !n.read_at)) { %>
    <form method="post" action="/notifications/lues"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button type="submit">Tout marquer comme lu</button></form>
  <% } %>
  <ul class="items card">
    <% for (const n of it.list) { %><li class="row between<%= n.read_at ? ' muted' : '' %>"><span><% if (href(n)) { %><a href="<%= href(n) %>"><%= text(n) %></a><% } else { %><%= text(n) %><% } %></span><span class="muted"><%= n.created_at.toLocaleString('fr-FR') %></span></li><% } %>
    <% if (!it.list.length) { %><li class="muted">Rien pour l’instant.</li><% } %>
  </ul>
  <p><a href="/jeu">Retour</a></p>
</section>
